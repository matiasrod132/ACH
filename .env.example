NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Console > Project settings > Cloud Messaging > Web configuration >
# "Generate key pair". Required for background push notifications (Ajustes).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# console.groq.com/keys — server-only (no NEXT_PUBLIC_ prefix, never sent to
# the browser). Powers the "Generar con IA" nutrition targets suggestion
# (app/api/nutrition-plan). Can reuse the same key already used by
# apps-script/Code.gs's GROQ_API_KEY script property, or a separate one.
GROQ_API_KEY=
# Optional — defaults to openai/gpt-oss-120b if unset (same default the
# Apps Script uses). Override if that model gets deprecated.
GROQ_MODEL=

# ---- Multi-user Gmail bank-email sync (any registered user, not just you) ----
# See CONFIGURAR_SYNC_MULTIUSUARIO.md for the full step-by-step setup.

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type "Web application"). Server-only — never sent to the browser.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Any long random string you make up yourself (e.g. `openssl rand -hex 32`).
# Signs the short-lived OAuth "state" param — prevents a forged redirect from
# linking Gmail to the wrong account.
OAUTH_STATE_SECRET=

# Another random string you make up. The external cron (cron-job.org, a
# GitHub Actions schedule, etc.) must send this back as
# `Authorization: Bearer <value>` or `?secret=<value>` when it hits
# /api/cron/sync-gmail — without it, the route rejects the request.
CRON_SECRET=

# Firebase Console > Project settings > Service accounts > Generate new
# private key (downloads a JSON file). Lets server routes (OAuth callback,
# the cron sync) write to Firestore without a signed-in browser session.
# Paste FIREBASE_ADMIN_PRIVATE_KEY exactly as it appears in the JSON
# (including the literal \n sequences and the BEGIN/END lines) — quote the
# whole value.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
