NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Console > Project settings > Cloud Messaging > Web configuration >
# "Generate key pair". Required for background push notifications (Ajustes).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# console.groq.com/keys — server-only (no NEXT_PUBLIC_ prefix, never sent to
# the browser). Powers the "Generar con IA" nutrition targets suggestion
# (app/api/nutrition-plan). Can reuse the same key already used by
# apps-script/Code.gs's GROQ_API_KEY script property, or a separate one.
GROQ_API_KEY=
# Optional — defaults to openai/gpt-oss-120b if unset (same default the
# Apps Script uses). Override if that model gets deprecated.
GROQ_MODEL=

# ---- Multi-user Gmail bank-email sync (any registered user, not just you) ----
# See CONFIGURAR_SYNC_MULTIUSUARIO.md for the full step-by-step setup.

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type "Web application"). Server-only — never sent to the browser.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Any long random string you make up yourself (e.g. `openssl rand -hex 32`).
# Signs the short-lived OAuth "state" param — prevents a forged redirect from
# linking Gmail to the wrong account.
OAUTH_STATE_SECRET=

# Another random string you make up. The external cron (cron-job.org, a
# GitHub Actions schedule, etc.) must send this back as
# `Authorization: Bearer <value>` or `?secret=<value>` when it hits
# /api/cron/sync-gmail — without it, the route rejects the request.
CRON_SECRET=

# Firebase Console > Project settings > Service accounts > Generate new
# private key (downloads a JSON file). Lets server routes (OAuth callback,
# the cron sync) write to Firestore without a signed-in browser session.
# Paste FIREBASE_ADMIN_PRIVATE_KEY exactly as it appears in the JSON
# (including the literal \n sequences and the BEGIN/END lines) — quote the
# whole value.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# The app's canonical public URL, e.g. https://ach.podsio.online — used to
# build the Gmail OAuth redirect_uri. Required in production: behind a
# proxy (Netlify, Vercel) the request's own origin can resolve to an
# internal deploy subdomain instead of your real domain, which Google
# rejects as a redirect_uri mismatch. Leave unset for local dev — it falls
# back to the request's own origin there (http://localhost:3000), which is
# correct.
APP_URL=

# ---- Sync con Microsoft (Outlook/Hotmail/Live) vía OAuth ----
# Azure Portal (portal.azure.com) > Microsoft Entra ID > App registrations.
# Server-only — never sent to the browser.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# ---- Correo general vía IMAP (cualquier proveedor, no solo Gmail) ----

# Any long random string you make up (e.g. `openssl rand -hex 32`).
# Encrypts IMAP app passwords at rest (see lib/server/crypto-secret.ts) —
# this is a real account credential, not a revocable OAuth token, so it's
# never stored in plaintext even though the collection is already
# client-inaccessible (see firestore.rules).
IMAP_CREDENTIALS_ENCRYPTION_KEY=
